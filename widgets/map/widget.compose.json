{
  "name": {
    "en": "Mower Map",
    "de": "Mäherkarte"
  },
  "height": "100%",
  "devices": {
    "type": "app",
    "singular": true
  },
  "settings": [
    {
      "id": "show_zones",
      "type": "checkbox",
      "label": {
        "en": "Show mowing zones",
        "de": "Mähzonen anzeigen"
      },
      "value": true
    },
    {
      "id": "show_forbidden",
      "type": "checkbox",
      "label": {
        "en": "Show forbidden areas",
        "de": "Verbotsbereiche anzeigen"
      },
      "value": true
    },
    {
      "id": "show_spots",
      "type": "checkbox",
      "label": {
        "en": "Show spot areas",
        "de": "Spotbereiche anzeigen"
      },
      "value": true
    },
    {
      "id": "show_robot",
      "type": "checkbox",
      "label": {
        "en": "Show robot position",
        "de": "Mäherposition anzeigen"
      },
      "value": true
    },
    {
      "id": "show_obstacles",
      "type": "checkbox",
      "label": {
        "en": "Show obstacles",
        "de": "Hindernisse anzeigen"
      },
      "value": true
    },
    {
      "id": "show_path",
      "type": "checkbox",
      "label": {
        "en": "Show driven route",
        "de": "Gefahrene Route anzeigen"
      },
      "value": true
    },
    {
      "id": "show_direction",
      "type": "checkbox",
      "label": {
        "en": "Show alternating mowing pattern",
        "de": "Mähmuster hell/dunkel anzeigen"
      },
      "value": true,
      "hint": {
        "en": "Shows the recorded mowing lanes as a persistent light/dark pattern: one travel direction bright, the opposite direction darker. Turns stay neutral. No instantaneous heading arrow is shown.",
        "de": "Zeigt die aufgezeichneten Mähbahnen dauerhaft als Hell/Dunkel-Muster: eine Fahrtrichtung hell, die Gegenrichtung dunkler. Wendungen bleiben neutral. Es wird kein momentaner Richtungspfeil angezeigt."
      }
    },
    {
      "id": "show_maintenance_point",
      "type": "checkbox",
      "label": {
        "en": "Show maintenance point",
        "de": "Wartungspunkt anzeigen"
      },
      "value": true,
      "hint": {
        "en": "Shows the mower maintenance point independently of Garage Mode.",
        "de": "Zeigt den Wartungspunkt des Mähers unabhängig vom Garagenmodus."
      }
    },
    {
      "id": "show_garage_overlay",
      "type": "checkbox",
      "label": {
        "en": "Show garage overlay",
        "de": "Garagen-Overlay anzeigen"
      },
      "value": true,
      "hint": {
        "en": "Shows the safety line, danger/caution areas, garage/dock marker and related garage labels. Only effective while Garage Mode is enabled.",
        "de": "Zeigt Sicherheitslinie, Gefahren-/Vorsichtsbereiche, Garage-/Dock-Markierung und zugehörige Garagenbeschriftungen. Nur bei aktiviertem Garagenmodus wirksam."
      }
    }
  ],
  "api": {
    "getMapData": {
      "method": "GET",
      "path": "/"
    },
    "updateGarageMarkers": {
      "method": "PUT",
      "path": "/garage-markers"
    },
    "updateObstacleRule": {
      "method": "PUT",
      "path": "/obstacle-rule"
    }
  }
}
