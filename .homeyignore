# Developer-only files that must not be shipped to the App Store.
#
# NOTE: this file cannot exclude scoped packages (node_modules/@types etc.) —
# the Homey CLI ignores such patterns. Dev dependencies are kept out of the
# published package by pruning them first; see the `prepublish:homey` script in
# package.json and the publishing note in README.md.

# Build-time image tooling (sharp) is only used by this script to render
# App Store preview images on a developer machine.
scripts/

# Developer documentation. The App Store reads readme.txt / readme.de.txt.
docs/
README.md

# Offline verification and native reference sources
tests/

# Historical release reviews are preserved in the source ZIP for audits, but
# are not runtime resources and must not be included in a Homey publish build.
RELEASE_NOTES_*.md
REVIEW_*.md
FINALER_TESTABLAUF_*.md
TESTBERICHT_*.md
TESTHINWEISE_*.md

# Release notes, audits and GitHub review artifacts stay in source bundles only.
RELEASE_*.md
UPSTREAM_SYNC_*.md
PR_REVIEW_*.md
PR_PHASE_*.md
PR_PHASE_MANIFEST.json
