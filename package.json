{
  "name": "com.mova-dreame.mower",
  "version": "1.2.0",
  "description": "Control MOVA and Dreame robotic lawn mowers from Homey",
  "main": "app.js",
  "scripts": {
    "start": "homey app run",
    "previews": "npm install && node scripts/generate-previews.js",
    "prepublish:homey": "npm prune --omit=dev",
    "publish:homey": "npm run prepublish:homey && homey app publish",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "homey",
    "mower",
    "dreame",
    "mova",
    "robotic",
    "lawn"
  ],
  "author": "Andi Wirz <andi@wirzfamily.ch>",
  "license": "MIT",
  "dependencies": {
    "mqtt": "^5.15.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
